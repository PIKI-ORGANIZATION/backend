generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// ///////////////////////////////////////////////
/// ///////////////////////////////////////////////
model Akun {
  uuid                String              @id @default(uuid()) @db.Uuid
  email               String              @unique
  username            String              @unique @default(uuid())
  password            String
  statusAkun          String              @default("PENDING_VERIFICATION")
  emailVerifyToken    String?             @unique
  emailVerifyExpiry   DateTime?
  resetPasswordToken  String?             @unique
  resetPasswordExpiry DateTime?
  lastLogin           DateTime?
  ipLogin             String?
  anggotaUuid         String?             @unique @db.Uuid
  insert_at           DateTime            @default(now())
  insert_by           String?             @db.Uuid
  update_at           DateTime            @updatedAt
  update_by           String?             @db.Uuid
  agendaInsert        AgendaKegiatan[]    @relation("AgendaInsertBy")
  anggota             Anggota?            @relation(fields: [anggotaUuid], references: [uuid])
  createdBy           Akun?               @relation("AkunInsertBy", fields: [insert_by], references: [uuid])
  created             Akun[]              @relation("AkunInsertBy")
  updatedBy           Akun?               @relation("AkunUpdateBy", fields: [update_by], references: [uuid])
  updated             Akun[]              @relation("AkunUpdateBy")
  roles               AkunRole[]
  albumInsert         AlbumGaleri[]       @relation("AlbumInsertBy")
  createdAnggota      Anggota[]           @relation("AnggotaInsertBy")
  updatedAnggota      Anggota[]           @relation("AnggotaUpdateBy")
  arsipInsert         ArsipKegiatan[]     @relation("ArsipInsertBy")
  ketua               Cabang?             @relation("Ketua")
  faqInsert           FAQ[]               @relation("FAQInsertBy")
  pengaduanInsert     FormPengaduan[]     @relation("PengaduanInsertBy")
  logAktivitas        LogAktivitas[]
  mediaInsert         MediaGaleri[]       @relation("MediaInsertBy")
  newsAuthor          NewsUtama[]         @relation("NewsAuthor")
  newsPublisher       NewsUtama[]         @relation("NewsPublisher")
  programInsert       ProgramKerja[]      @relation("ProgramInsertBy")
  registrasiList      Registrasi?
  registrasiPengurus  RegistrasiPengurus?
}

/// ///////////////////////////////////////////////
/// ///////////////////////////////////////////////
model Anggota {
  uuid               String               @id @default(uuid()) @db.Uuid
  namaLengkap        String
  namaPanggil        String?
  tempatLahir        String?
  tanggalLahir       DateTime?            @db.Date
  alamat             String?
  bio                String?
  pesanKesan         String?
  angkatan           String?
  provinsi           String?
  kotaDomisili       String?
  pendidikanUuid     String?              @db.Uuid
  pekerjaanUuid      String?              @db.Uuid
  bidangStudiUuid    String?              @db.Uuid
  bidangMinatUuid    String?              @db.Uuid
  profileImg         String?
  noWa               String?
  instagram          String?
  facebook           String?
  statusKeanggotaan  String               @default("NON_MEMBER")
  isApprovedByPCPS   Boolean              @default(false)
  isApprovedByPNPS   Boolean              @default(false)
  approvedByPCPSUuid String?              @db.Uuid
  approvedAtPCPS     DateTime?
  approvedByPNPSUuid String?              @db.Uuid
  approvedAtPNPS     DateTime?
  cabangUuid         String?              @db.Uuid
  insert_at          DateTime             @default(now())
  insert_by          String?              @db.Uuid
  update_at          DateTime             @updatedAt
  update_by          String?              @db.Uuid
  akun               Akun?
  approverPCPS       Anggota?             @relation("ApproverPCPS", fields: [approvedByPCPSUuid], references: [uuid])
  approvedPCPS       Anggota[]            @relation("ApproverPCPS")
  approverPNPS       Anggota?             @relation("ApproverPNPS", fields: [approvedByPNPSUuid], references: [uuid])
  approvedPNPS       Anggota[]            @relation("ApproverPNPS")
  bidangMinatRef     MasterBidangMinat?   @relation(fields: [bidangMinatUuid], references: [uuid])
  bidangStudiRef     MasterBidangStudi?   @relation(fields: [bidangStudiUuid], references: [uuid])
  cabang             Cabang?              @relation(fields: [cabangUuid], references: [uuid])
  createdBy          Akun?                @relation("AnggotaInsertBy", fields: [insert_by], references: [uuid])
  pekerjaanRef       MasterPekerjaan?     @relation(fields: [pekerjaanUuid], references: [uuid])
  pendidikanRef      MasterPendidikan?    @relation(fields: [pendidikanUuid], references: [uuid])
  updatedBy          Akun?                @relation("AnggotaUpdateBy", fields: [update_by], references: [uuid])
  strukturPNPS       StrukturOrganisasi[] @relation("StrukturAnggota")
}

/// ///////////////////////////////////////////////
/// ///////////////////////////////////////////////
model Cabang {
  uuid                   String                @id @default(uuid()) @db.Uuid
  namaCabang             String
  alamat                 String?
  kabupatenKota          String
  provinsi               String
  wilayah                String?
  statusCabang           String                @default("ACTIVE")
  isCabang               Boolean               @default(true)
  deskripsiCabang        String
  visi                   String
  noWa                   String
  instagram              String
  facebook               String
  youtube                String
  email                  String                @unique
  urlBannerImg           String?
  titleHomeHero          String?
  headlineHomeHero       String?
  isCountdownActive      Boolean               @default(false)
  endTimeCountdown       DateTime?
  keteranganCountdown    String?
  ketuaUuid              String?               @unique @db.Uuid
  insert_at              DateTime              @default(now())
  insert_by              String?               @db.Uuid
  update_at              DateTime              @updatedAt
  update_by              String?               @db.Uuid
  AlbumGaleriList        AlbumGaleri[]
  anggotaList            Anggota[]
  ketua                  Akun?                 @relation("Ketua", fields: [ketuaUuid], references: [uuid])
  misi                   MisiCabang[]
  newsList               NewsUtama[]
  periodeList            PeriodeKepengurusan[]
  sejarahCabang          SejarahCabang[]
  registrasiList         Registrasi[]
  registrasiPengurusList RegistrasiPengurus[]
}

model MisiCabang {
  uuid        String   @id @default(uuid()) @db.Uuid
  teks        String
  cabang_uuid String   @db.Uuid
  insert_at   DateTime @default(now())
  update_at   DateTime @updatedAt
  cabang      Cabang   @relation(fields: [cabang_uuid], references: [uuid])
}

model SejarahCabang {
  uuid                String   @id @default(uuid()) @db.Uuid
  timeline            String
  deskripsiTimeline   String
  gambar              String?
  statusSejarahCabang String   @default("ACTIVE")
  cabang_uuid         String   @db.Uuid
  insert_at           DateTime @default(now())
  insert_by           String?  @db.Uuid
  update_at           DateTime @updatedAt
  update_by           String?  @db.Uuid
  cabang              Cabang   @relation(fields: [cabang_uuid], references: [uuid])
}

model PeriodeKepengurusan {
  uuid         String               @id @default(uuid()) @db.Uuid
  namaPeriode  String
  tahunMulai   Int
  tahunSelesai Int
  isAktif      Boolean              @default(false)
  cabangUuid   String?              @db.Uuid
  insert_at    DateTime             @default(now())
  insert_by    String?              @db.Uuid
  update_at    DateTime             @updatedAt
  update_by    String?              @db.Uuid
  cabang       Cabang?              @relation(fields: [cabangUuid], references: [uuid])
  strukturList StrukturOrganisasi[]
}

model StrukturOrganisasi {
  uuid          String              @id @default(uuid()) @db.Uuid
  atasanUuid    String?             @db.Uuid
  periodeUuid   String              @db.Uuid
  anggotaUuid   String              @db.Uuid
  jabatanUuid   String              @db.Uuid
  bidangUuid    String?             @db.Uuid
  urutan        Int                 @default(0)
  levelOverride Int?
  insert_at     DateTime            @default(now())
  insert_by     String?             @db.Uuid
  update_at     DateTime            @updatedAt
  update_by     String?             @db.Uuid
  anggota       Anggota             @relation("StrukturAnggota", fields: [anggotaUuid], references: [uuid])
  bidang        Bidang?             @relation(fields: [bidangUuid], references: [uuid])
  jabatan       Jabatan             @relation(fields: [jabatanUuid], references: [uuid])
  periode       PeriodeKepengurusan @relation(fields: [periodeUuid], references: [uuid])

  @@index([periodeUuid])
  @@index([anggotaUuid])
}

model Jabatan {
  uuid         String               @id @default(uuid()) @db.Uuid
  namaJabatan  String               @unique
  levelJabatan Int
  insert_at    DateTime             @default(now())
  insert_by    String?              @db.Uuid
  update_at    DateTime             @updatedAt
  update_by    String?              @db.Uuid
  strukturList StrukturOrganisasi[]
}

model Bidang {
  uuid         String               @id @default(uuid()) @db.Uuid
  namaBidang   String               @unique
  insert_at    DateTime             @default(now())
  insert_by    String?              @db.Uuid
  update_at    DateTime             @updatedAt
  update_by    String?              @db.Uuid
  strukturList StrukturOrganisasi[]
}

model ProgramKerja {
  uuid          String           @id @default(uuid()) @db.Uuid
  namaProgram   String
  deskripsi     String?
  tujuan        String?
  sasaran       String?
  bidang        String?
  statusProgram String           @default("AKTIF")
  tahun         Int
  thumbnail     String?
  insert_at     DateTime         @default(now())
  insert_by     String?          @db.Uuid
  update_at     DateTime         @updatedAt
  update_by     String?          @db.Uuid
  agendaList    AgendaKegiatan[]
  insertBy      Akun?            @relation("ProgramInsertBy", fields: [insert_by], references: [uuid])
}

model AgendaKegiatan {
  uuid            String          @id @default(uuid()) @db.Uuid
  namaAgenda      String
  deskripsi       String?
  tanggalMulai    DateTime
  tanggalSelesai  DateTime?
  lokasi          String?
  jenisKegiatan   String          @default("OFFLINE")
  statusAgenda    String          @default("SEGERA")
  thumbnail       String?
  linkPendaftaran String?
  programUuid     String?         @db.Uuid
  insert_at       DateTime        @default(now())
  insert_by       String?         @db.Uuid
  update_at       DateTime        @updatedAt
  update_by       String?         @db.Uuid
  insertBy        Akun?           @relation("AgendaInsertBy", fields: [insert_by], references: [uuid])
  program         ProgramKerja?   @relation(fields: [programUuid], references: [uuid])
  arsipList       ArsipKegiatan[]
}

model ArsipKegiatan {
  uuid         String          @id @default(uuid()) @db.Uuid
  judul        String
  deskripsi    String?
  tanggalArsip DateTime
  jenisArsip   String          @default("LAPORAN")
  fileUrl      String?
  thumbnail    String?
  isPublic     Boolean         @default(true)
  agendaUuid   String?         @db.Uuid
  insert_at    DateTime        @default(now())
  insert_by    String?         @db.Uuid
  update_at    DateTime        @updatedAt
  update_by    String?         @db.Uuid
  agenda       AgendaKegiatan? @relation(fields: [agendaUuid], references: [uuid])
  insertBy     Akun?           @relation("ArsipInsertBy", fields: [insert_by], references: [uuid])
}

model AlbumGaleri {
  uuid            String        @id @default(uuid()) @db.Uuid
  namaAlbum       String
  deskripsi       String?
  tanggalKegiatan DateTime
  coverMedia      String?
  isPublic        Boolean       @default(true)
  statusAlbum     String        @default("ACTIVE")
  cabangUuid      String?       @db.Uuid
  newsUtamaUuid   String?       @db.Uuid
  insert_at       DateTime      @default(now())
  insert_by       String?       @db.Uuid
  update_at       DateTime      @updatedAt
  update_by       String?       @db.Uuid
  cabang          Cabang?       @relation(fields: [cabangUuid], references: [uuid])
  insertBy        Akun?         @relation("AlbumInsertBy", fields: [insert_by], references: [uuid])
  newsUtama       NewsUtama?    @relation(fields: [newsUtamaUuid], references: [uuid])
  mediaList       MediaGaleri[]

  @@index([cabangUuid])
}

model MediaGaleri {
  uuid       String      @id @default(uuid()) @db.Uuid
  tipeMedia  String
  urlMedia   String
  thumbnail  String?
  keterangan String?
  urutan     Int         @default(0)
  durasi     String?
  albumUuid  String      @db.Uuid
  insert_at  DateTime    @default(now())
  insert_by  String?     @db.Uuid
  update_at  DateTime    @updatedAt
  update_by  String?     @db.Uuid
  album      AlbumGaleri @relation(fields: [albumUuid], references: [uuid])
  insertBy   Akun?       @relation("MediaInsertBy", fields: [insert_by], references: [uuid])

  @@index([albumUuid])
}

model FormPengaduan {
  uuid             String    @id @default(uuid()) @db.Uuid
  namaPelapor      String
  emailPelapor     String
  noWaPelapor      String?
  subjek           String
  isiBadan         String
  kategoriAduan    String    @default("UMUM")
  statusPengaduan  String    @default("MASUK")
  tanggapan        String?
  tanggalTanggapan DateTime?
  isAnonymous      Boolean   @default(false)
  insert_at        DateTime  @default(now())
  insert_by        String?   @db.Uuid
  update_at        DateTime  @updatedAt
  update_by        String?   @db.Uuid
  respondedBy      Akun?     @relation("PengaduanInsertBy", fields: [insert_by], references: [uuid])
}

model FAQ {
  uuid       String   @id @default(uuid()) @db.Uuid
  pertanyaan String
  jawaban    String
  kategori   String   @default("UMUM")
  urutan     Int      @default(0)
  isPublish  Boolean  @default(true)
  statusFAQ  String   @default("ACTIVE")
  insert_at  DateTime @default(now())
  insert_by  String?  @db.Uuid
  update_at  DateTime @updatedAt
  update_by  String?  @db.Uuid
  insertBy   Akun?    @relation("FAQInsertBy", fields: [insert_by], references: [uuid])
}

/// ///////////////////////////////////////////////
/// ///////////////////////////////////////////////
model NewsUtama {
  uuid              String              @id @default(uuid()) @db.Uuid
  judul             String
  ringkasan         String?
  konten            String
  slug              String              @unique
  url_thumbnail_img String?
  statusNewsUtama   String              @default("DRAFT")
  author_akun_uuid  String              @db.Uuid
  published_at      DateTime?
  published_by      String?             @db.Uuid
  jumlah_dibaca     Int                 @default(0)
  jumlah_disukai    Int                 @default(0)
  jumlah_komentar   Int                 @default(0)
  durasi_baca       Int?
  cabangUuid        String?             @db.Uuid
  insert_at         DateTime            @default(now())
  insert_by         String?             @db.Uuid
  update_at         DateTime            @updatedAt
  update_by         String?             @db.Uuid
  albumList         AlbumGaleri[]
  author            Akun                @relation("NewsAuthor", fields: [author_akun_uuid], references: [uuid])
  cabang            Cabang?             @relation(fields: [cabangUuid], references: [uuid])
  publisher         Akun?               @relation("NewsPublisher", fields: [published_by], references: [uuid])
  kategori          NewsUtamaKategori[]
  tags              NewsUtamaTag[]
}

/// ///////////////////////////////////////////////
/// ///////////////////////////////////////////////
model NewsTag {
  uuid              String         @id @default(uuid()) @db.Uuid
  nama_tag          String         @unique
  jumlah_penggunaan Int            @default(0)
  status_tag        String         @default("ACTIVE")
  insert_at         DateTime       @default(now())
  insert_by         String?        @db.Uuid
  update_at         DateTime       @updatedAt
  update_by         String?        @db.Uuid
  news              NewsUtamaTag[]
}

/// ///////////////////////////////////////////////
/// ///////////////////////////////////////////////
model NewsKategori {
  uuid            String              @id @default(uuid()) @db.Uuid
  nama_kategori   String
  slug            String              @unique
  deskripsi       String?
  status_kategori String              @default("ACTIVE")
  insert_at       DateTime            @default(now())
  insert_by       String?             @db.Uuid
  update_at       DateTime            @updatedAt
  update_by       String?             @db.Uuid
  news            NewsUtamaKategori[]
}

model NewsUtamaTag {
  uuid            String    @id @default(uuid()) @db.Uuid
  news_utama_uuid String    @db.Uuid
  news_tag_uuid   String    @db.Uuid
  insert_at       DateTime  @default(now())
  insert_by       String?   @db.Uuid
  update_at       DateTime  @updatedAt
  update_by       String?   @db.Uuid
  tag             NewsTag   @relation(fields: [news_tag_uuid], references: [uuid])
  news            NewsUtama @relation(fields: [news_utama_uuid], references: [uuid])

  @@unique([news_utama_uuid, news_tag_uuid])
}

model NewsUtamaKategori {
  uuid               String       @id @default(uuid()) @db.Uuid
  news_utama_uuid    String       @db.Uuid
  news_kategori_uuid String       @db.Uuid
  insert_at          DateTime     @default(now())
  insert_by          String?      @db.Uuid
  update_at          DateTime     @updatedAt
  update_by          String?      @db.Uuid
  kategori           NewsKategori @relation(fields: [news_kategori_uuid], references: [uuid])
  news               NewsUtama    @relation(fields: [news_utama_uuid], references: [uuid])

  @@unique([news_utama_uuid, news_kategori_uuid])
}

model Role {
  uuid        String           @id @default(uuid()) @db.Uuid
  namaRole    String           @unique
  deskripsi   String?
  statusRole  String           @default("ACTIVE")
  insert_at   DateTime         @default(now())
  insert_by   String?          @db.Uuid
  update_at   DateTime         @updatedAt
  update_by   String?          @db.Uuid
  akuns       AkunRole[]
  permissions PermissionRole[]
}

model Permission {
  uuid             String           @id @default(uuid()) @db.Uuid
  namaPermission   String           @unique
  deskripsi        String?
  statusPermission String           @default("ACTIVE")
  insert_at        DateTime         @default(now())
  insert_by        String?          @db.Uuid
  update_at        DateTime         @updatedAt
  update_by        String?          @db.Uuid
  roles            PermissionRole[]
}

model AkunRole {
  uuid      String   @id @default(uuid()) @db.Uuid
  akunUuid  String   @db.Uuid
  roleUuid  String   @db.Uuid
  insert_at DateTime @default(now())
  insert_by String?  @db.Uuid
  update_at DateTime @updatedAt
  update_by String?  @db.Uuid
  akun      Akun     @relation(fields: [akunUuid], references: [uuid])
  role      Role     @relation(fields: [roleUuid], references: [uuid])

  @@unique([akunUuid, roleUuid])
}

model PermissionRole {
  uuid           String     @id @default(uuid()) @db.Uuid
  permissionUuid String     @db.Uuid
  roleUuid       String     @db.Uuid
  insert_at      DateTime   @default(now())
  insert_by      String?    @db.Uuid
  update_at      DateTime   @updatedAt
  update_by      String?    @db.Uuid
  permission     Permission @relation(fields: [permissionUuid], references: [uuid])
  role           Role       @relation(fields: [roleUuid], references: [uuid])

  @@unique([permissionUuid, roleUuid])
}

model pageSetting {
  uuid      String          @id @default(uuid()) @db.Uuid
  key       String          @unique
  nama      String
  type      PageSettingType @default(TEXT)
  value     String
  insert_at DateTime        @default(now())
  insert_by String?         @db.Uuid
  update_at DateTime        @updatedAt
  update_by String?         @db.Uuid
}

model LogAktivitas {
  uuid          String         @id @default(uuid()) @db.Uuid
  akunUuid      String?        @db.Uuid
  aktivitas     JenisAktivitas
  table         String
  deskripsi     Json?
  uuidReferensi String
  insert_at     DateTime       @default(now())
  akun          Akun?          @relation(fields: [akunUuid], references: [uuid])
}

model MasterPendidikan {
  uuid        String    @id @default(uuid()) @db.Uuid
  nama        String    @unique
  insert_at   DateTime  @default(now())
  update_at   DateTime  @updatedAt
  anggotaList Anggota[]
}

model MasterPekerjaan {
  uuid        String    @id @default(uuid()) @db.Uuid
  nama        String    @unique
  insert_at   DateTime  @default(now())
  update_at   DateTime  @updatedAt
  anggotaList Anggota[]
}

model MasterBidangStudi {
  uuid        String    @id @default(uuid()) @db.Uuid
  nama        String    @unique
  insert_at   DateTime  @default(now())
  update_at   DateTime  @updatedAt
  anggotaList Anggota[]
}

model MasterBidangMinat {
  uuid        String    @id @default(uuid()) @db.Uuid
  nama        String    @unique
  insert_at   DateTime  @default(now())
  update_at   DateTime  @updatedAt
  anggotaList Anggota[]
}

/// ///////////////////////////////////////////////
/// ///////////////////////////////////////////////
model Registrasi {
  id                    String          @id @default(uuid()) @db.Uuid
  namaLengkap           String
  tanggalLahir          DateTime        @db.Date
  noWa                  String
  email                 String
  alamatDomisili        String
  fileKtpUrl            String
  dpd                   String?
  dpc                   String?
  kode_provinsi         String?
  kode_kabupaten        String?
  kotaDomisili          String?
  tingkatPendidikan     String?
  pendidikanUuid        String?         @db.Uuid
  pekerjaan             String?
  pekerjaanUuid         String?         @db.Uuid
  minatBidang           String?
  bidangMinatUuid       String?         @db.Uuid
  motivasiBergabung     String?
  setujuKebenaranData   Boolean         @default(false)
  setujuPengelolaanData Boolean         @default(false)
  setujuKerahasiaanData Boolean         @default(false)
  tglPersetujuanPdp     DateTime?
  statusVerifikasi      String          @default("PENDING_VERIFIKASI_DPC")
  verifikatorUuid       String?         @db.Uuid
  catatanVerifikasi     String?
  tglVerifikasi         DateTime?
  isBypassedSla         Boolean         @default(false)
  tglBypassSla          DateTime?
  statusPembayaran      String          @default("UNPAID")
  buktiBayarUrl         String?
  statusKta             String          @default("INACTIVE")
  noKta                 String?         @unique
  fileKtaUrl            String?
  tglAktivasiKta        DateTime?
  akunUuid              String?         @unique @db.Uuid
  anggotaUuid           String?         @unique @db.Uuid
  langkahSekarang       Int             @default(1)
  created_at            DateTime        @default(now())
  created_by            String?         @db.Uuid
  updated_at            DateTime        @updatedAt
  updated_by            String?         @db.Uuid
  cabangUuid            String?         @db.Uuid
  akun                  Akun?           @relation(fields: [akunUuid], references: [uuid])
  cabang                Cabang?         @relation(fields: [cabangUuid], references: [uuid])
  logs                  RegistrasiLog[]

  @@map("registrasi")
}

model RegistrasiLog {
  id           String     @id @default(uuid()) @db.Uuid
  registrasiId String     @db.Uuid
  aksi         String
  keterangan   String?
  actorUuid    String?    @db.Uuid
  actorNama    String?
  created_at   DateTime   @default(now())
  registrasi   Registrasi @relation(fields: [registrasiId], references: [id], onDelete: Cascade)

  @@map("registrasi_log")
}

/// ///////////////////////////////////////////////
/// ///////////////////////////////////////////////
model DataMasterWilayah {
  id             Int     @id @default(autoincrement())
  kode_provinsi  String?
  nama_provinsi  String?
  kode_kabupaten String?
  nama_kabupaten String?
  kode_kecamatan String?
  nama_kecamatan String?
  kode_kel_desa  String? @db.VarChar(13)
  nama_kel_desa  String? @db.VarChar(255)

  @@index([kode_provinsi])
  @@index([kode_kabupaten])
  @@map("data_master_wilayah")
}

/// ///////////////////////////////////////////////
/// ///////////////////////////////////////////////
model DpdDpc {
  id             Int       @id @default(autoincrement())
  dpd            String?   @db.VarChar(255)
  dpc            String?   @db.VarChar(255)
  kode_provinsi  String?   @db.VarChar(20)
  kode_kabupaten String?   @db.VarChar(20)
  pengurus       String?   @db.VarChar(255)
  no_handphone   String?   @db.VarChar(100)
  keterangan     String?   @db.VarChar(255)
  penerbitan_sk  String?   @db.VarChar(50)
  created_at     DateTime? @default(now())
  updated_at     DateTime? @default(now()) @updatedAt

  @@map("dpd_dpc")
}

/// ///////////////////////////////////////////////
/// ///////////////////////////////////////////////
model RegistrasiPengurus {
  id                String    @id @default(uuid()) @db.Uuid
  namaLengkap       String
  noWa              String
  email             String
  tingkat           String
  jabatan           String
  kode_provinsi     String?
  kode_kabupaten    String?
  cabangUuid        String?   @db.Uuid
  skKepengurusanUrl String
  statusVerifikasi  String    @default("PENDING_VERIFIKASI")
  verifikatorUuid   String?   @db.Uuid
  catatanVerifikasi String?
  tglVerifikasi     DateTime?
  akunUuid          String?   @unique @db.Uuid
  created_at        DateTime  @default(now())
  created_by        String?   @db.Uuid
  updated_at        DateTime  @updatedAt
  updated_by        String?   @db.Uuid
  akun              Akun?     @relation(fields: [akunUuid], references: [uuid])
  cabang            Cabang?   @relation(fields: [cabangUuid], references: [uuid])

  @@map("registrasi_pengurus")
}

/// ///////////////////////////////////////////////
/// ///////////////////////////////////////////////
model Dpd {
  id           String    @id @default(uuid()) @db.Uuid
  kodeProvinsi String?   @db.VarChar(20)
  dpd          String?   @db.VarChar(255)
  pengurus     String?   @db.VarChar(255)
  noHandphone  String?   @db.VarChar(100)
  keterangan   String?   @db.VarChar(255)
  penerbitanSk String?   @db.VarChar(50)
  createdAt    DateTime? @default(now())
  updatedAt    DateTime? @default(now()) @updatedAt
  createdBy    String?   @db.Uuid
  updatedBy    String?   @db.Uuid

  @@map("dpd")
}

