generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//////////////////////////////////////////////////
// AKUN (AUTH + AUTHOR NEWS)
//////////////////////////////////////////////////
model Akun {
  uuid String @id @default(uuid()) @db.Uuid

  email      String @unique
  username   String @unique @default(uuid())
  password   String
  statusAkun String @default("PENDING_VERIFICATION")

  emailVerifyToken  String?   @unique
  emailVerifyExpiry DateTime?

  resetPasswordToken  String?   @unique
  resetPasswordExpiry DateTime?

  lastLogin DateTime?
  ipLogin   String?

  // ========================
  // RELASI KE SENIOR & REGISTRASI
  // ========================
  seniorUuid     String?      @unique @db.Uuid
  senior         Senior?      @relation(fields: [seniorUuid], references: [uuid])
  registrasiList Registrasi[]
  registrasiPengurus RegistrasiPengurus?

  ulasanProduk UlasanProduk[]

  logAktivitas LogAktivitas[]

  ketua Cabang? @relation("Ketua")

  // ========================
  // RBAC
  // ========================
  roles AkunRole[]

  // ========================
  // NEWS RELATION
  // ========================
  newsAuthor    NewsUtama[] @relation("NewsAuthor")
  newsPublisher NewsUtama[] @relation("NewsPublisher")

  // ========================
  // PROGRAM RELATION
  // ========================
  programInsert ProgramKerja[]   @relation("ProgramInsertBy")
  agendaInsert  AgendaKegiatan[] @relation("AgendaInsertBy")
  arsipInsert   ArsipKegiatan[]  @relation("ArsipInsertBy")

  // ========================
  // GALERI RELATION
  // ========================
  albumInsert AlbumGaleri[] @relation("AlbumInsertBy")
  mediaInsert MediaGaleri[] @relation("MediaInsertBy")

  // ========================
  // KRITIK SARAN RELATION
  // ========================
  pengaduanInsert FormPengaduan[] @relation("PengaduanInsertBy")
  faqInsert       FAQ[]           @relation("FAQInsertBy")

  // ========================
  // GRIT INSTITUT RELATION
  // ========================
  layananInsert TopikEdukasi[] @relation("TopikEdukasiInsertBy")
  mentorInsert  Mentor[]       @relation("MentorInsertBy")
  kelasInsert   Kelas[]        @relation("KelasInsertBy")

  keranjangList KeranjangBelanja[]
  pesananList   Pesanan[]

  // ========================
  // AUDIT
  // ========================
  insert_at DateTime @default(now())
  insert_by String?  @db.Uuid
  update_at DateTime @updatedAt
  update_by String?  @db.Uuid

  createdBy Akun? @relation("AkunInsertBy", fields: [insert_by], references: [uuid])
  updatedBy Akun? @relation("AkunUpdateBy", fields: [update_by], references: [uuid])

  created Akun[] @relation("AkunInsertBy")
  updated Akun[] @relation("AkunUpdateBy")

  createdSenior Senior[] @relation("SeniorInsertBy")
  updatedSenior Senior[] @relation("SeniorUpdateBy")
}

//////////////////////////////////////////////////
// SENIOR
//////////////////////////////////////////////////
model Senior {
  uuid String @id @default(uuid()) @db.Uuid

  namaLengkap  String
  namaPanggil  String?
  tempatLahir  String?
  tanggalLahir DateTime? @db.Date
  alamat       String?   @db.Text
  bio          String?   @db.Text
  pesanKesan   String?   @db.Text
  angkatan     String?
  // jabatan           String?
  
  provinsi       String?
  kotaDomisili   String?

  // ========================
  // MASTER DATA RELATIONS (NEW)
  // ========================
  pendidikanUuid   String? @db.Uuid
  pekerjaanUuid    String? @db.Uuid
  bidangStudiUuid  String? @db.Uuid
  bidangMinatUuid  String? @db.Uuid

  pendidikanRef     MasterPendidikan?  @relation(fields: [pendidikanUuid], references: [uuid])
  pekerjaanRef      MasterPekerjaan?   @relation(fields: [pekerjaanUuid], references: [uuid])
  bidangStudiRef    MasterBidangStudi? @relation(fields: [bidangStudiUuid], references: [uuid])
  bidangMinatRef    MasterBidangMinat? @relation(fields: [bidangMinatUuid], references: [uuid])
  profileImg        String?
  noWa              String?
  instagram         String?
  facebook          String?
  statusKeanggotaan String             @default("NON_MEMBER")
  isApprovedByPCPS  Boolean            @default(false)
  isApprovedByPNPS  Boolean            @default(false)

  // ========================
  // APPROVAL TRACKING
  // ========================
  approvedByPCPSUuid String?   @db.Uuid
  approvedAtPCPS     DateTime?
  approvedByPNPSUuid String?   @db.Uuid
  approvedAtPNPS     DateTime?

  approverPCPS Senior? @relation("ApproverPCPS", fields: [approvedByPCPSUuid], references: [uuid])
  approverPNPS Senior? @relation("ApproverPNPS", fields: [approvedByPNPSUuid], references: [uuid])

  approvedPCPS Senior[] @relation("ApproverPCPS")
  approvedPNPS Senior[] @relation("ApproverPNPS")

  // ========================
  // RELASI KE CABANG
  // ========================
  cabangUuid String? @db.Uuid
  cabang     Cabang? @relation(fields: [cabangUuid], references: [uuid])

  // ========================
  // RELASI KE STRUKTUR ORGANISASI
  // ========================
  strukturPNPS StrukturOrganisasi[] @relation("StrukturSenior")

  // ========================
  // OPTIONAL RELASI KE AKUN
  // ========================
  akun Akun?

  produkList  Produk[]
  pesananList Pesanan[]

  // ========================
  // AUDIT
  // ========================
  insert_at DateTime @default(now())
  insert_by String?  @db.Uuid
  update_at DateTime @updatedAt
  update_by String?  @db.Uuid

  createdBy Akun? @relation("SeniorInsertBy", fields: [insert_by], references: [uuid])
  updatedBy Akun? @relation("SeniorUpdateBy", fields: [update_by], references: [uuid])
}

//////////////////////////////////////////////////
// CABANG
//////////////////////////////////////////////////
model Cabang {
  uuid String @id @default(uuid()) @db.Uuid

  namaCabang      String
  alamat          String?
  kabupatenKota   String
  provinsi        String
  wilayah         String?
  statusCabang    String  @default("ACTIVE")
  isCabang        Boolean @default(true) // true = cabang daerah, false = pusat
  deskripsiCabang String

  // VISI MISI
  visi String
  misi MisiCabang[]

  // KONTAK CABANG
  noWa      String
  instagram String
  facebook  String
  youtube   String
  email     String @unique

  // SETTINGAN HOMEHERO PAGE BANNER
  urlBannerImg     String?
  titleHomeHero    String?
  headlineHomeHero String?

  // COUNTDWON SETTING
  isCountdownActive   Boolean   @default(false)
  endTimeCountdown    DateTime?
  keteranganCountdown String?

  // ========================
  // KETUA CABANG (AKUN)
  // ========================
  ketuaUuid String? @unique @db.Uuid
  ketua     Akun?   @relation("Ketua", fields: [ketuaUuid], references: [uuid])

  // ========================
  // RELASI KE SENIOR
  // ========================
  seniors Senior[]

  // ========================
  // RELASI KE PERIODE KEPENGURUSAN
  // ========================
  periodeList PeriodeKepengurusan[]

  // RELASI KE SEJARAH CABANG
  sejarahCabang SejarahCabang[]

  // RELASI KE NEWS UTAMA
  newsList NewsUtama[]

  // RELASI KE REGISTRASI
  registrasiList Registrasi[]
  registrasiPengurusList RegistrasiPengurus[]

  // RELASI KE GALERI
  AlbumGaleriList AlbumGaleri[]

  // ========================
  // AUDIT
  // ========================
  insert_at DateTime @default(now())
  insert_by String?  @db.Uuid
  update_at DateTime @updatedAt
  update_by String?  @db.Uuid
}

model MisiCabang {
  uuid String @id @default(uuid()) @db.Uuid
  teks String @db.Text

  cabang_uuid String @db.Uuid
  cabang      Cabang @relation(fields: [cabang_uuid], references: [uuid])

  insert_at DateTime @default(now())
  update_at DateTime @updatedAt
}

model SejarahCabang {
  uuid                String  @id @default(uuid()) @db.Uuid
  timeline            String
  deskripsiTimeline   String
  gambar              String?
  statusSejarahCabang String  @default("ACTIVE") // "ACTIVE" | "NON_ACTIVE"

  cabang_uuid String @db.Uuid
  cabang      Cabang @relation(fields: [cabang_uuid], references: [uuid])

  insert_at DateTime @default(now())
  insert_by String?  @db.Uuid
  update_at DateTime @updatedAt
  update_by String?  @db.Uuid
}

// ================================================
// STRUKTUR ORGANISASI
// Mendukung: PNPS (pusat) & PCPS (cabang)
// ================================================

// Periode kepengurusan
model PeriodeKepengurusan {
  uuid         String  @id @default(uuid()) @db.Uuid
  namaPeriode  String // e.g. "2025-2028"
  tahunMulai   Int
  tahunSelesai Int
  isAktif      Boolean @default(false)

  // RELASI KE CABANG
  cabangUuid String? @db.Uuid
  cabang     Cabang? @relation(fields: [cabangUuid], references: [uuid])

  strukturList StrukturOrganisasi[]

  insert_at DateTime @default(now())
  insert_by String?  @db.Uuid
  update_at DateTime @updatedAt
  update_by String?  @db.Uuid
}

model StrukturOrganisasi {
  uuid String @id @default(uuid()) @db.Uuid

  // ATASAN (SELF RELATION)
  atasanUuid String? @db.Uuid

  // RELASI PERIODE
  periodeUuid String              @db.Uuid
  periode     PeriodeKepengurusan @relation(fields: [periodeUuid], references: [uuid])

  // RELASI SENIOR
  seniorUuid String @db.Uuid
  senior     Senior @relation("StrukturSenior", fields: [seniorUuid], references: [uuid])

  // RELASI JABATAN
  jabatanUuid String  @db.Uuid
  jabatan     Jabatan @relation(fields: [jabatanUuid], references: [uuid])

  // RELASI BIDANG (optional)
  bidangUuid String? @db.Uuid
  bidang     Bidang? @relation(fields: [bidangUuid], references: [uuid])

  urutan        Int  @default(0)
  levelOverride Int? // Override level spesifik untuk struktur ini, menimpa Jabatan.levelJabatan

  insert_at DateTime @default(now())
  insert_by String?  @db.Uuid
  update_at DateTime @updatedAt
  update_by String?  @db.Uuid

  @@index([periodeUuid])
  @@index([seniorUuid])
}

model Jabatan {
  uuid         String @id @default(uuid()) @db.Uuid
  namaJabatan  String @unique
  levelJabatan Int // untuk menentukan hierarki (0 = tertinggi, 1, 2, dst)

  strukturList StrukturOrganisasi[]

  insert_at DateTime @default(now())
  insert_by String?  @db.Uuid
  update_at DateTime @updatedAt
  update_by String?  @db.Uuid
}

model Bidang {
  uuid       String @id @default(uuid()) @db.Uuid
  namaBidang String @unique

  strukturList StrukturOrganisasi[]

  insert_at DateTime @default(now())
  insert_by String?  @db.Uuid
  update_at DateTime @updatedAt
  update_by String?  @db.Uuid
}

// ================================================
// PROGRAM KERJA
// Mendukung: Katalog Program Kerja, Agenda Kegiatan,
//            Arsip Kegiatan (Laporan)
// ================================================

model ProgramKerja {
  uuid String @id @default(uuid()) @db.Uuid

  namaProgram   String
  deskripsi     String? @db.Text
  tujuan        String? @db.Text
  sasaran       String?
  bidang        String? // bidang terkait
  statusProgram String  @default("AKTIF") // "AKTIF" | "SELESAI" | "DIBATALKAN"
  tahun         Int
  thumbnail     String?

  // Agenda terkait program ini
  agendaList AgendaKegiatan[]

  insertBy Akun? @relation("ProgramInsertBy", fields: [insert_by], references: [uuid])

  insert_at DateTime @default(now())
  insert_by String?  @db.Uuid
  update_at DateTime @updatedAt
  update_by String?  @db.Uuid
}

model AgendaKegiatan {
  uuid String @id @default(uuid()) @db.Uuid

  namaAgenda      String
  deskripsi       String?   @db.Text
  tanggalMulai    DateTime
  tanggalSelesai  DateTime?
  lokasi          String?
  jenisKegiatan   String    @default("OFFLINE") // "OFFLINE" | "ONLINE" | "HYBRID"
  statusAgenda    String    @default("SEGERA") // "SEGERA" | "BERLANGSUNG" | "SELESAI" | "DIBATALKAN" | "DITUNDA"
  thumbnail       String?
  linkPendaftaran String?

  // Relasi ke program kerja (opsional)
  programUuid String?       @db.Uuid
  program     ProgramKerja? @relation(fields: [programUuid], references: [uuid])

  // Arsip laporan kegiatan
  arsipList ArsipKegiatan[]

  insertBy Akun? @relation("AgendaInsertBy", fields: [insert_by], references: [uuid])

  insert_at DateTime @default(now())
  insert_by String?  @db.Uuid
  update_at DateTime @updatedAt
  update_by String?  @db.Uuid
}

model ArsipKegiatan {
  uuid String @id @default(uuid()) @db.Uuid

  judul        String
  deskripsi    String?  @db.Text
  tanggalArsip DateTime
  jenisArsip   String   @default("LAPORAN") // "LAPORAN" | "DOKUMENTASI" | "NOTULENSI" | "SK"
  fileUrl      String? // URL file laporan/dokumen
  thumbnail    String?
  isPublic     Boolean  @default(true)

  // Relasi ke agenda (opsional)
  agendaUuid String?         @db.Uuid
  agenda     AgendaKegiatan? @relation(fields: [agendaUuid], references: [uuid])

  insertBy Akun? @relation("ArsipInsertBy", fields: [insert_by], references: [uuid])

  insert_at DateTime @default(now())
  insert_by String?  @db.Uuid
  update_at DateTime @updatedAt
  update_by String?  @db.Uuid
}

// ================================================
// GALERI
// Mendukung: Album Foto Kegiatan, Video Dokumentasi
// ================================================
model AlbumGaleri {
  uuid String @id @default(uuid()) @db.Uuid

  namaAlbum       String
  deskripsi       String?
  tanggalKegiatan DateTime
  coverMedia      String? // bisa foto atau thumbnail video
  isPublic        Boolean  @default(true) // apakah album ini boleh dilihat publik atau hanya internal
  statusAlbum     String   @default("ACTIVE") // "ACTIVE" | "ARCHIVED"

  // RELASI CABANG
  cabangUuid String? @db.Uuid
  cabang     Cabang? @relation(fields: [cabangUuid], references: [uuid])

  // RELASI NEWS UTAMA (opsional, jika album terkait dengan berita tertentu)
  newsUtamaUuid String?    @db.Uuid
  newsUtama     NewsUtama? @relation(fields: [newsUtamaUuid], references: [uuid])

  // RELASI THE GRIT INSTITUT (opsional, jika album terkait dengan kelas/layanan tertentu)
  kelasUuid String? @db.Uuid
  kelas     Kelas?  @relation(fields: [kelasUuid], references: [uuid])

  // ISI GALERI (gabungan foto + video)
  mediaList MediaGaleri[]

  insertBy Akun? @relation("AlbumInsertBy", fields: [insert_by], references: [uuid])

  insert_at DateTime @default(now())
  insert_by String?  @db.Uuid
  update_at DateTime @updatedAt
  update_by String?  @db.Uuid

  // INDEX UNTUK PERFORMA QUERY ALBUM PER CABANG
  @@index([cabangUuid])
}

// Media dalam galeri (bisa foto atau video)
model MediaGaleri {
  uuid String @id @default(uuid()) @db.Uuid

  // TIPE MEDIA
  tipeMedia String // "FOTO" | "VIDEO"

  // FILE / URL
  urlMedia  String
  thumbnail String? // khusus video atau optional

  // META
  keterangan String?
  urutan     Int     @default(0)

  // OPTIONAL (khusus video)
  durasi String?

  // RELASI KE ALBUM (Media Galeri bisa harus punya album)
  albumUuid String      @db.Uuid
  album     AlbumGaleri @relation(fields: [albumUuid], references: [uuid])

  insertBy Akun? @relation("MediaInsertBy", fields: [insert_by], references: [uuid])

  insert_at DateTime @default(now())
  insert_by String?  @db.Uuid
  update_at DateTime @updatedAt
  update_by String?  @db.Uuid

  // INDEX UNTUK PERFORMA QUERY MEDIA DALAM ALBUM
  @@index([albumUuid])
}

// ================================================
// KRITIK & SARAN
// Mendukung: Form Pengaduan, FAQ
// ================================================

model FormPengaduan {
  uuid String @id @default(uuid()) @db.Uuid

  namaPelapor      String
  emailPelapor     String
  noWaPelapor      String?
  subjek           String
  isiBadan         String    @db.Text
  kategoriAduan    String    @default("UMUM") // "UMUM" | "ORGANISASI" | "PELAYANAN" | "LAINNYA"
  statusPengaduan  String    @default("MASUK") // "MASUK" | "DIPROSES" | "SELESAI" | "DITOLAK"
  tanggapan        String?   @db.Text // respon dari admin
  tanggalTanggapan DateTime?
  isAnonymous      Boolean   @default(false)

  // Akun yang merespons (opsional, bisa admin)
  respondedBy Akun? @relation("PengaduanInsertBy", fields: [insert_by], references: [uuid])

  insert_at DateTime @default(now())
  insert_by String?  @db.Uuid
  update_at DateTime @updatedAt
  update_by String?  @db.Uuid
}

model FAQ {
  uuid String @id @default(uuid()) @db.Uuid

  pertanyaan String  @db.Text
  jawaban    String  @db.Text
  kategori   String  @default("UMUM") // "UMUM" | "KEANGGOTAAN" | "PROGRAM" | "ORGANISASI"
  urutan     Int     @default(0) // untuk sorting tampilan
  isPublish  Boolean @default(true)
  statusFAQ  String  @default("ACTIVE") // "ACTIVE" | "ARCHIVED"

  insertBy Akun? @relation("FAQInsertBy", fields: [insert_by], references: [uuid])

  insert_at DateTime @default(now())
  insert_by String?  @db.Uuid
  update_at DateTime @updatedAt
  update_by String?  @db.Uuid
}

// ================================================
// THE GRIT INSTITUT
// Mendukung: Layanan Edukasi/Kurikulum,
//            Profil Mentor/Pengajar,
//            Daftar Kelas/Workshop
