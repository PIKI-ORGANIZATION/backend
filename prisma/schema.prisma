model TopikEdukasi {
  uuid String @id @default(uuid()) @db.Uuid

  namaTopikEdukasi      String
  deskripsiTopikEdukasi String? @db.Text
  targetPeserta         String?
  thumbnailTopikEdukasi String?
  statusTopikEdukasi    String  @default("ACTIVE")

  // MANY TO MANY
  kelasList KelasTopikEdukasi[]

  insertBy Akun? @relation("TopikEdukasiInsertBy", fields: [insert_by], references: [uuid])

  insert_at DateTime @default(now())
  insert_by String?  @db.Uuid
  update_at DateTime @updatedAt
  update_by String?  @db.Uuid
}

model Mentor {
  uuid String @id @default(uuid()) @db.Uuid

  namaLengkap  String
  namaPanggil  String?
  bio          String? @db.Text
  keahlian     String? // bidang keahlian
  pendidikan   String?
  pengalaman   String? @db.Text
  profileImg   String?
  instagram    String?
  linkedin     String?
  email        String?
  statusMentor String  @default("ACTIVE") // "ACTIVE" | "INACTIVE"

  // Kelas yang diajar
  // MANY TO MANY
  kelasList KelasMentor[]

  insertBy Akun? @relation("MentorInsertBy", fields: [insert_by], references: [uuid])

  insert_at DateTime @default(now())
  insert_by String?  @db.Uuid
  update_at DateTime @updatedAt
  update_by String?  @db.Uuid
}

model Kelas {
  uuid String @id @default(uuid()) @db.Uuid

  namaKelas          String
  deskripsiKelas     String?   @db.Text
  jenisKelas         String    @default("WORKSHOP") // "WORKSHOP" | "KURSUS" | "SEMINAR" | "BOOTCAMP"
  metodePembelajaran String    @default("OFFLINE") // "OFFLINE" | "ONLINE" | "HYBRID"
  tanggalMulai       DateTime
  tanggalSelesai     DateTime?
  lokasi             String?
  linkOnline         String?
  harga              Decimal?  @default(0.0) @db.Decimal(12, 2) // null = gratis
  maxPeserta         Int?
  thumbnail          String?
  statusKelas        String    @default("UPCOMING") // "UPCOMING" | "BERLANGSUNG" | "SELESAI" | "DIBATALKAN"

  // Relasi many to many
  mentorList KelasMentor[]
  topikList  KelasTopikEdukasi[]

  // ONE TO ONE (reverse, 1 kelas punya 1 newsUtama)
  newsUtama NewsUtama?

  // Pendaftaran peserta
  pendaftaranList PendaftaranKelas[]

  // RELASI KE ALBUM GALERI (opsional, jika kelas punya dokumentasi foto/video)
  albumList AlbumGaleri[]

  // RELASI KE NEWS UTAMA (opsional, jika kelas punya news)
  // newsUtamaList NewsUtama[]

  insertBy Akun? @relation("KelasInsertBy", fields: [insert_by], references: [uuid])

  insert_at DateTime @default(now())
  insert_by String?  @db.Uuid
  update_at DateTime @updatedAt
  update_by String?  @db.Uuid
}

model KelasMentor {
  uuid String @id @default(uuid()) @db.Uuid

  kelasUuid  String @db.Uuid
  mentorUuid String @db.Uuid

  kelas  Kelas  @relation(fields: [kelasUuid], references: [uuid])
  mentor Mentor @relation(fields: [mentorUuid], references: [uuid])

  // optional: role mentor di kelas
  role String? // "MAIN_MENTOR" -> Mentor Utama | "CO_MENTOR" -> Mentor Pendamping

  insert_at DateTime @default(now())

  @@unique([kelasUuid, mentorUuid])
}

model KelasTopikEdukasi {
  uuid String @id @default(uuid()) @db.Uuid

  kelasUuid        String @db.Uuid
  topikEdukasiUuid String @db.Uuid

  kelas        Kelas        @relation(fields: [kelasUuid], references: [uuid])
  topikEdukasi TopikEdukasi @relation(fields: [topikEdukasiUuid], references: [uuid])

  insert_at DateTime @default(now())

  @@unique([kelasUuid, topikEdukasiUuid])
}

// Pendaftaran peserta kelas (join table + data tambahan)
model PendaftaranKelas {
  uuid String @id @default(uuid()) @db.Uuid

  kelasUuid String @db.Uuid
  kelas     Kelas  @relation(fields: [kelasUuid], references: [uuid])

  // Data peserta (tidak harus senior/akun — bisa publik)
  namaPeserta       String
  emailPeserta      String
  noWaPeserta       String?
  statusPendaftaran String   @default("PENDING") // "PENDING" | "DITERIMA" | "DITOLAK" | "HADIR"
  catatanPeserta    String? // catatan/harapan dari peserta
  buktiTransferUrl  String? // url foto bukti transfer
  tanggalDaftar     DateTime @default(now())

  insert_at DateTime @default(now())
  insert_by String?  @db.Uuid
  update_at DateTime @updatedAt
  update_by String?  @db.Uuid

  @@unique([kelasUuid, emailPeserta])
}

//////////////////////////////////////////////////
// NEWS UTAMA
//////////////////////////////////////////////////
model NewsUtama {
  uuid String @id @default(uuid()) @db.Uuid

  judul             String
  ringkasan         String?
  konten            String  @db.Text
  slug              String  @unique
  url_thumbnail_img String?
  statusNewsUtama   String  @default("DRAFT") // DRAFT, PUBLISHED, ARCHIVED

  author_akun_uuid String    @db.Uuid
  published_at     DateTime?
  published_by     String?   @db.Uuid

  jumlah_dibaca   Int  @default(0)
  jumlah_disukai  Int  @default(0)
  jumlah_komentar Int  @default(0)
  durasi_baca     Int? // estimasi durasi baca dalam menit

  author    Akun  @relation("NewsAuthor", fields: [author_akun_uuid], references: [uuid])
  publisher Akun? @relation("NewsPublisher", fields: [published_by], references: [uuid])

  tags     NewsUtamaTag[]
  kategori NewsUtamaKategori[]

  cabangUuid String? @db.Uuid
  cabang     Cabang? @relation(fields: [cabangUuid], references: [uuid])

  // Tambahkan @unique di kelasUuid apabila ingin 1 News hanya bisa 1 Kelas TGI atau sebaliknya
  kelasUuid String? @unique @db.Uuid
  kelas     Kelas?  @relation(fields: [kelasUuid], references: [uuid])

  // RELASI KE GALERI (opsional, jika berita punya dokumentasi foto/video)
  albumList AlbumGaleri[]

  insert_at DateTime @default(now())
  insert_by String?  @db.Uuid
  update_at DateTime @updatedAt
  update_by String?  @db.Uuid
}

//////////////////////////////////////////////////
// NEWS TAG
//////////////////////////////////////////////////
model NewsTag {
  uuid              String @id @default(uuid()) @db.Uuid
  nama_tag          String @unique
  jumlah_penggunaan Int    @default(0)
  status_tag        String @default("ACTIVE")

  news NewsUtamaTag[]

  insert_at DateTime @default(now())
  insert_by String?  @db.Uuid
  update_at DateTime @updatedAt
  update_by String?  @db.Uuid
}

//////////////////////////////////////////////////
// NEWS KATEGORI
//////////////////////////////////////////////////
model NewsKategori {
  uuid            String  @id @default(uuid()) @db.Uuid
  nama_kategori   String
  slug            String  @unique
  deskripsi       String?
  status_kategori String  @default("ACTIVE")

  news NewsUtamaKategori[]

  insert_at DateTime @default(now())
  insert_by String?  @db.Uuid
  update_at DateTime @updatedAt
  update_by String?  @db.Uuid
}

model NewsUtamaTag {
  uuid String @id @default(uuid()) @db.Uuid

  news_utama_uuid String @db.Uuid
  news_tag_uuid   String @db.Uuid

  news NewsUtama @relation(fields: [news_utama_uuid], references: [uuid])
  tag  NewsTag   @relation(fields: [news_tag_uuid], references: [uuid])

  insert_at DateTime @default(now())
  insert_by String?  @db.Uuid
  update_at DateTime @updatedAt
  update_by String?  @db.Uuid

  @@unique([news_utama_uuid, news_tag_uuid])
}

model NewsUtamaKategori {
  uuid String @id @default(uuid()) @db.Uuid

  news_utama_uuid    String @db.Uuid
  news_kategori_uuid String @db.Uuid

  news     NewsUtama    @relation(fields: [news_utama_uuid], references: [uuid])
  kategori NewsKategori @relation(fields: [news_kategori_uuid], references: [uuid])

  insert_at DateTime @default(now())
  insert_by String?  @db.Uuid
  update_at DateTime @updatedAt
  update_by String?  @db.Uuid

  @@unique([news_utama_uuid, news_kategori_uuid])
}

// ================================================
// E-COMMERCE
// ================================================

enum JenisProduk {
  JASA
  PRODUK_FISIK
}

enum StatusProduk {
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
}

enum StatusOrder {
  WAITING_ONGKIR
  WAITING_CONFIRMATION
  DELIVERING
  COMPLETED
  CANCELED
}

enum StatusPembayaran {
  PENDING
  PAID
  CANCELED // misal karena timeout atau bukti transfer tidak valid
  REFUNDED
  // status khusus untuk pembayaran yang sudah diterima admin tapi belum dibayarkan ke senior sebagai penjual, untuk memastikan keamanan transaksi terutama untuk produk digital yang bisa langsung diakses setelah pembayaran diterima.
  SELLER_PAID
}

enum MetodePembayaran {
  TRANSFER_BANK
  CASH
  E_WALLET
}

// PRODUK & PRODUK KATEGORI
model ProdukKategori {
  uuid         String      @id @default(uuid()) @db.Uuid
  namaKategori String      @unique
  tipeProduk   JenisProduk @default(PRODUK_FISIK)

  produk Produk[]

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
}

model Produk {
  uuid String @id @default(uuid()) @db.Uuid

  namaProduk   String
  deskripsi    String?      @db.Text
  gambarProduk String? // URL gambar produk
  harga        Decimal      @db.Decimal(12, 5)
  hargaAsli    Decimal?     @db.Decimal(12, 5) // harga sebelum diskon
  diskonPersen Int?         @default(0)
  stok         Int
  statusProduk StatusProduk @default(ACTIVE)

  ratingRataRata Decimal @default(0) @db.Decimal(2, 1)
  jumlahRating   Int     @default(0)

  produkKategoriUuid String         @db.Uuid
  produkKategori     ProdukKategori @relation(fields: [produkKategoriUuid], references: [uuid])

  seniorUuid String @db.Uuid
  senior     Senior @relation(fields: [seniorUuid], references: [uuid])

  spesifikasi SpesifikasiProduk[]
  keranjang   KeranjangBelanja[]
  orderItems  ProdukPesanan[]

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
}

model UlasanProduk {
  uuid String @id @default(uuid()) @db.Uuid

  akunUuid String @db.Uuid
  akun     Akun   @relation(fields: [akunUuid], references: [uuid])

  produkPesananUuid String        @db.Uuid
  produkPesanan     ProdukPesanan @relation(fields: [produkPesananUuid], references: [uuid])

  rating   Int
  komentar String? @db.Text

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // 1 user hanya bisa review 1 item pesanan
  @@unique([produkPesananUuid])
}

// SPESIFIKASI PRODUK (misal: warna, ukuran, bahan, dll)
model SpesifikasiProduk {
  uuid String @id @default(uuid()) @db.Uuid

  namaSpesifikasi String

  produkUuid String @db.Uuid
  produk     Produk @relation(fields: [produkUuid], references: [uuid])

  values SpesifikasiProdukValue[]

  keranjangSpesifikasi KeranjangSpesifikasi[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model SpesifikasiProdukValue {
  uuid String @id @default(uuid()) @db.Uuid

  namaValue String

  spesifikasiUuid String            @db.Uuid
  spesifikasi     SpesifikasiProduk @relation(fields: [spesifikasiUuid], references: [uuid])

  keranjangSpesifikasi KeranjangSpesifikasi[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

// KERANJANG BELANJA & KERANGJANG SPESIFIKASI (join table untuk menyimpan pilihan spesifikasi di keranjang)
model KeranjangBelanja {
  uuid String @id @default(uuid()) @db.Uuid

  produkUuid String @db.Uuid
  produk     Produk @relation(fields: [produkUuid], references: [uuid])

  akunUuid String? @db.Uuid
  akun     Akun?   @relation(fields: [akunUuid], references: [uuid])

  jumlah     Int     @default(1)
  totalHarga Decimal @db.Decimal(12, 5)

  spesifikasi KeranjangSpesifikasi[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([produkUuid, akunUuid])
}

model KeranjangSpesifikasi {
  uuid String @id @default(uuid()) @db.Uuid

  keranjangUuid String           @db.Uuid
  keranjang     KeranjangBelanja @relation(fields: [keranjangUuid], references: [uuid])

  spesifikasiUuid String            @db.Uuid
  spesifikasi     SpesifikasiProduk @relation(fields: [spesifikasiUuid], references: [uuid])

  valueUuid String                 @db.Uuid
  value     SpesifikasiProdukValue @relation(fields: [valueUuid], references: [uuid])
}

// PESANAN
model PengaturanPesanan {
  uuid String @id @default(uuid()) @db.Uuid

  pajakPesanan       Json
  pajakProdukPesanan Json

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Pesanan {
  uuid String @id @default(uuid()) @db.Uuid

  seniorUuid String @db.Uuid
  senior     Senior @relation(fields: [seniorUuid], references: [uuid])

  akunUuid String? @db.Uuid
  akun     Akun?   @relation(fields: [akunUuid], references: [uuid])

  namaPenerima String
  alamat       String
  noHp         String
  email        String
  kodePos      String
  kota         String

  // tracking_number / no resi
  nomorResi      String?
  jasaPengiriman String?

  statusPesanan    StatusOrder      @default(WAITING_ONGKIR)
  statusPembayaran StatusPembayaran @default(PENDING)
  nomorPembayaran  String?

  ongkir       Decimal @default(0) @db.Decimal(12, 5)
  biayaLayanan Decimal @default(0) @db.Decimal(12, 5)

  subtotal    Decimal @db.Decimal(12, 5)
  diskonTotal Decimal @db.Decimal(12, 5)
  pajakTotal  Decimal @db.Decimal(12, 5)
  total       Decimal @db.Decimal(12, 5)

  produkPesanan      ProdukPesanan[]
  pajakPesananRelasi PajakPesanan[]
  pembayaran         Pembayaran?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model ProdukPesanan {
  uuid String @id @default(uuid()) @db.Uuid

  pesananUuid String  @db.Uuid
  pesanan     Pesanan @relation(fields: [pesananUuid], references: [uuid])

  produkUuid String @db.Uuid
  produk     Produk @relation(fields: [produkUuid], references: [uuid])

  jumlah     Int
  harga      Decimal @db.Decimal(12, 5)
  diskon     Decimal @db.Decimal(12, 5)
  subtotal   Decimal @db.Decimal(12, 5)
  pajakTotal Decimal @db.Decimal(12, 5)
  total      Decimal @db.Decimal(12, 5)

  spesifikasi ProdukPesananSpesifikasi[]
  pajak       PajakProdukPesanan[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt @default(now())
  deleted_at DateTime?

  ulasanProduk UlasanProduk?
}

// SNAPSHOT SPESIFIKASI PRODUK DI WAKTU PESANAN (untuk menyimpan nama spesifikasi dan value yang dipilih saat pemesanan, 
// karena bisa saja spesifikasi produk berubah di masa depan)
model ProdukPesananSpesifikasi {
  uuid String @id @default(uuid()) @db.Uuid

  produkPesananUuid String        @db.Uuid
  produkPesanan     ProdukPesanan @relation(fields: [produkPesananUuid], references: [uuid])

  spesifikasiUuid String @db.Uuid
  valueUuid       String @db.Uuid

  namaSpesifikasi String
  namaValue       String
}

model PajakPesanan {
  uuid String @id @default(uuid()) @db.Uuid

  pesananUuid String  @db.Uuid
  pesanan     Pesanan @relation(fields: [pesananUuid], references: [uuid])

  nama  String
  rasio Float
}

model PajakProdukPesanan {
  uuid String @id @default(uuid()) @db.Uuid

  produkPesananUuid String        @db.Uuid
  produkPesanan     ProdukPesanan @relation(fields: [produkPesananUuid], references: [uuid])

  nama  String
  rasio Float
}

model Pembayaran {
  uuid String @id @default(uuid()) @db.Uuid

  pesananUuid String  @unique @db.Uuid
  pesanan     Pesanan @relation(fields: [pesananUuid], references: [uuid])

  metode MetodePembayaran

  namaPengirim String?
  bankPengirim String?
  jumlahBayar  Decimal @db.Decimal(12, 5)

  urlBuktiPembayaran String? // URL image

  nomorReferensi String? // opsional (no transfer)

  tanggalBayar DateTime?

  status StatusPembayaran @default(PENDING)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

// ================================================
// RBAC MODELS
// ================================================
model Role {
  uuid       String  @id @default(uuid()) @db.Uuid
  namaRole   String  @unique
  deskripsi  String?
  statusRole String  @default("ACTIVE")

  akuns       AkunRole[]
  permissions PermissionRole[]

  insert_at DateTime @default(now())
  insert_by String?  @db.Uuid
  update_at DateTime @updatedAt
  update_by String?  @db.Uuid
}

model Permission {
  uuid             String  @id @default(uuid()) @db.Uuid
  namaPermission   String  @unique
  deskripsi        String?
  statusPermission String  @default("ACTIVE")

  roles PermissionRole[]

  insert_at DateTime @default(now())
  insert_by String?  @db.Uuid
  update_at DateTime @updatedAt
  update_by String?  @db.Uuid
}

model AkunRole {
  uuid String @id @default(uuid()) @db.Uuid

  akunUuid String @db.Uuid
  roleUuid String @db.Uuid

  akun Akun @relation(fields: [akunUuid], references: [uuid])
  role Role @relation(fields: [roleUuid], references: [uuid])

  insert_at DateTime @default(now())
  insert_by String?  @db.Uuid
  update_at DateTime @updatedAt
  update_by String?  @db.Uuid

  @@unique([akunUuid, roleUuid])
}

model PermissionRole {
  uuid String @id @default(uuid()) @db.Uuid

  permissionUuid String @db.Uuid
  roleUuid       String @db.Uuid

  permission Permission @relation(fields: [permissionUuid], references: [uuid])
  role       Role       @relation(fields: [roleUuid], references: [uuid])

  insert_at DateTime @default(now())
  insert_by String?  @db.Uuid
  update_at DateTime @updatedAt
  update_by String?  @db.Uuid

  @@unique([permissionUuid, roleUuid])
}

enum PageSettingType {
  TEXT
  NUMBER
  ARRAY
  IMAGE
}

// SETTING PAGE
model pageSetting {
  uuid String @id @default(uuid()) @db.Uuid

  key   String          @unique
  nama  String          @db.Text
  type  PageSettingType @default(TEXT)
  value String          @db.Text

  insert_at DateTime @default(now())
  insert_by String?  @db.Uuid
  update_at DateTime @updatedAt
  update_by String?  @db.Uuid
}

enum JenisAktivitas {
  CREATE
  UPDATE
  DELETE
}

// LOG AKTIVITAS (untuk mencatat aktivitas penting seperti login, perubahan data, dll)
model LogAktivitas {
  uuid String @id @default(uuid()) @db.Uuid

  akunUuid String? @db.Uuid
  akun     Akun?   @relation(fields: [akunUuid], references: [uuid])

  aktivitas JenisAktivitas

  // nama model/table
  table String

  // deskripsi aktivitas, bisa berupa JSON string untuk menyimpan data lama dan baru
  deskripsi Json?

  // uuid data yang terkait dengan aktivitas ini (misal uuid news yang diedit)
  uuidReferensi String @db.Text

  insert_at DateTime @default(now())
}

// ========================
// MASTER DATA FOR SENIOR
// ========================
model MasterPendidikan {
  uuid      String   @id @default(uuid()) @db.Uuid
  nama      String   @unique
  seniors   Senior[]
  insert_at DateTime @default(now())
  update_at DateTime @updatedAt
}

model MasterPekerjaan {
  uuid      String   @id @default(uuid()) @db.Uuid
  nama      String   @unique
  seniors   Senior[]
  insert_at DateTime @default(now())
  update_at DateTime @updatedAt
}

model MasterBidangStudi {
  uuid      String   @id @default(uuid()) @db.Uuid
  nama      String   @unique
  seniors   Senior[]
  insert_at DateTime @default(now())
  update_at DateTime @updatedAt
}

model MasterBidangMinat {
  uuid      String   @id @default(uuid()) @db.Uuid
  nama      String   @unique
  seniors   Senior[]
  insert_at DateTime @default(now())
  update_at DateTime @updatedAt
}

//////////////////////////////////////////////////
// REGISTRASI & KTANISASI PIKI
//////////////////////////////////////////////////
model Registrasi {
  id String @id @default(uuid()) @db.Uuid

  // TAHAP 1.1: IDENTITAS DIRI
  namaLengkap    String
  tanggalLahir   DateTime @db.Date
  noWa           String
  email          String
  alamatDomisili String   @db.Text
  fileKtpUrl     String
  nik            String?  @unique

  // TAHAP 1.2: KUALIFIKASI ORGANISASI
  dpp               String?  // Pilihan DPP (misal: "Sumatera Utara")
  dpc               String?  // Pilihan DPC (misal: "Kota Medan" / "Kabupaten Langkat")
  kode_provinsi     String?  // Kode provinsi dari master wilayah
  kode_kabupaten    String?  // Kode kabupaten dari master wilayah
  cabangUuid        String? @db.Uuid
  cabang            Cabang? @relation(fields: [cabangUuid], references: [uuid])
  kotaDomisili      String?
  tingkatPendidikan String?
  pendidikanUuid    String? @db.Uuid
  pekerjaan         String?
  pekerjaanUuid     String? @db.Uuid
  minatBidang       String?
  bidangMinatUuid   String? @db.Uuid
  motivasiBergabung String? @db.Text

  // TAHAP 1.3: PERSETUJUAN UU PDP
  setujuKebenaranData   Boolean   @default(false)
  setujuPengelolaanData Boolean   @default(false)
  setujuKerahasiaanData Boolean   @default(false)
  tglPersetujuanPdp     DateTime?

  // TAHAP 2 & 3: VERIFIKASI DPC & SLA BYPASS
  statusVerifikasi  String    @default("PENDING_VERIFIKASI_DPC")
  verifikatorUuid   String?   @db.Uuid
  catatanVerifikasi String?   @db.Text
  tglVerifikasi     DateTime?
  isBypassedSla     Boolean   @default(false)
  tglBypassSla      DateTime?

  // TAHAP 4: PEMBAYARAN IURAN
  statusPembayaran String    @default("UNPAID")
  noTagihan        String?   @unique
  nominalIuran     Float     @default(0)
  buktiBayarUrl    String?
  tglPembayaran    DateTime?

  // TAHAP 5: AKTIVASI KTA DIGITAL
  statusKta      String    @default("INACTIVE")
  noKta          String?   @unique
  fileKtaUrl     String?
  tglAktivasiKta DateTime?
  akunUuid       String?   @unique @db.Uuid
  akun           Akun?     @relation(fields: [akunUuid], references: [uuid])
  seniorUuid     String?   @unique @db.Uuid

  // State Progres Tahapan saat ini (1 s/d 5)
  langkahSekarang Int @default(1)

  // AUDIT FIELDS
  created_at DateTime @default(now())
  created_by String?  @db.Uuid
  updated_at DateTime @updatedAt
  updated_by String?  @db.Uuid

  // RELASI LOG HISTORI
  logs RegistrasiLog[]

  @@map("registrasi")
}

model RegistrasiLog {
  id           String     @id @default(uuid()) @db.Uuid
  registrasiId String     @db.Uuid
  registrasi   Registrasi @relation(fields: [registrasiId], references: [id], onDelete: Cascade)

  aksi        String
  keterangan  String?  @db.Text
  actorUuid   String?  @db.Uuid
  actorNama   String?
  created_at  DateTime @default(now())

  @@map("registrasi_log")
}

//////////////////////////////////////////////////
// MASTER WILAYAH INDONESIA (REFERENSI DROPDOWN)
//////////////////////////////////////////////////
model DataMasterWilayah {
  id             Int     @id @default(autoincrement())
  kode_provinsi  String?
  nama_provinsi  String?
  kode_kabupaten String?
  nama_kabupaten String?
  kode_kecamatan String?
  nama_kecamatan String?
  kode_kel_desa  String? @db.VarChar(13)
  nama_kel_desa  String? @db.VarChar(255)

  @@index([kode_provinsi])
  @@index([kode_kabupaten])
  @@map("data_master_wilayah")
}

//////////////////////////////////////////////////
// DPP DPC (MASTER PENGURUS CABANG PIKI)
//////////////////////////////////////////////////
model DppDpc {
  id            Int       @id @default(autoincrement())
  dpp           String?   @db.VarChar(255) // DPP (Provinsi)
  dpc           String?   @db.VarChar(255) // DPC (Kab/Kota)
  kode_provinsi String?   @db.VarChar(20)
  kode_kabupaten String?  @db.VarChar(20)
  pengurus      String?   @db.VarChar(255)
  no_handphone  String?   @db.VarChar(100)
  keterangan    String?   @db.VarChar(255)
  penerbitan_sk String?   @db.VarChar(50)
  created_at    DateTime? @default(now())
  updated_at    DateTime? @default(now()) @updatedAt

  @@map("dpp_dpc")
}

//////////////////////////////////////////////////
// REGISTRASI PENGURUS (DPP/DPC)
//////////////////////////////////////////////////
model RegistrasiPengurus {
  id String @id @default(uuid()) @db.Uuid
  
  namaLengkap String
  noWa        String
  email       String
  tingkat     String   // DPP atau DPC
  jabatan     String
  
  // Relasi opsional ke master wilayah/cabang
  kode_provinsi  String?
  kode_kabupaten String?
  cabangUuid     String? @db.Uuid
  cabang         Cabang? @relation(fields: [cabangUuid], references: [uuid])
  
  skKepengurusanUrl String
  
  statusVerifikasi  String    @default("PENDING_VERIFIKASI")
  verifikatorUuid   String?   @db.Uuid
  catatanVerifikasi String?   @db.Text
  tglVerifikasi     DateTime?
  
  // Ketika di-ACC, kita buatkan akun
  akunUuid String? @unique @db.Uuid
  akun     Akun?   @relation(fields: [akunUuid], references: [uuid])

  created_at DateTime @default(now())
  created_by String?  @db.Uuid
  updated_at DateTime @updatedAt
  updated_by String?  @db.Uuid

  @@map("registrasi_pengurus")
}
