//   insertBy      Akun?   @relation("TopikEdukasiInsertBy", fields: [insert_by], references: [uuid])

//   insert_at DateTime @default(now())
//   insert_by String?  @db.Uuid
//   update_at DateTime @updatedAt
//   update_by String?  @db.Uuid
