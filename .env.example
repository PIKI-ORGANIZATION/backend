PORT=3000
NODE_ENV=development

# Database
POSTGRES_USER=admin
POSTGRES_PASSWORD=password
POSTGRES_DB=pnps_db
POSTGRES_PORT=5432
DATABASE_URL="postgresql://admin:password@localhost:5432/pnps_db?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_SOCKET=/tmp/redis.sock
REDIS_PASSWORD=
REDIS_DB=0
# Security
CORS_ORIGIN=*
JWT_SECRET=pnps-super-secret-key-dev-2026
JWT_EXPIRES_IN=7d

# SMTP (gunakan Ethereal untuk dev, ganti ke SMTP asli untuk production)
SMTP_TYPE=log
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@pnps.id

# Frontend URL (untuk link verifikasi email)
FRONTEND_URL=http://localhost:5173